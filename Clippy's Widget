        jkoDelay: 2,
        jkoCycles: 20,
        accent: '#00E676',
        scale: 1,
        ghostOpacity: 0.15,
        weatherUnit: 'F',
        weatherType: 'feels',
        darkModeUI: true,
        darkModeBG: true,
        saveEnabled: true,
        muted: false,
        showLocation: false
    };

    let state = {
        isRunning: false,
        isPaused: false,
        mode: 'home',
        cycle: 0,
        failCount: 0,
        uptimeStart: Date.now(),
