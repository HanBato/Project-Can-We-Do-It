    if (state.config.darkModeUI) widget.classList.add('win-dark-ui');
    if (state.config.darkModeBG) document.body.classList.add('win-dark-bg');

    // Navigation
    const pages = widget.querySelectorAll('.page');
    const navBtns = widget.querySelectorAll('.win-nav-btn');
    navBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            navBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            pages.forEach(p => p.classList.remove('active'));
            widget.querySelector(`#page-${btn.dataset.page}`).classList.add('active');
            playSound('click');
        });
    });

    // References
    const els = {
        status: widget.querySelector('#text-status'),
        progress: widget.querySelector('#progress-bar'),
        timer: widget.querySelector('#header-timer'),
        weather: widget.querySelector('#header-weather'),
        headerStatus: widget.querySelector('#header-status')
    };

    // Timer Loop
    setInterval(() => {
        const d = Date.now() - state.uptimeStart;
        const h = String(Math.floor(d/3600000)).padStart(2,'0');
        const m = String(Math.floor((d%3600000)/60000)).padStart(2,'0');
        const s = String(Math.floor((d%60000)/1000)).padStart(2,'0');
        els.timer.innerText = `${h}:${m}:${s}`;
    }, 1000);

    // Weather
    const updateWeather = async () => {
        try {
            const r = await fetch('https://wttr.in/?format=j1');
            const j = await r.json();
            const c = j.current_condition[0];
            const area = j.nearest_area[0];
            const unit = widget.querySelector('#s-unit').value;
            const type = widget.querySelector('input[name="w-type"]:checked').value;
            
            let temp = unit === 'F' ? c.temp_F : c.temp_C;
            if (type === 'feels') temp = unit === 'F' ? c.FeelsLikeF : c.FeelsLikeC;
            
            const desc = c.weatherDesc[0].value.toLowerCase();
            let icon = '☀️';
            if(desc.includes('rain')) icon = '🌧️';
            else if(desc.includes('cloud')) icon = '☁️';
            else if(desc.includes('clear') && (new Date().getHours()>20 || new Date().getHours()<6)) icon = '🌙';
            
            let locText = "";
            if (state.config.showLocation) {
                locText = `${area.areaName[0].value} `;
            }
            
            els.weather.innerText = `${locText}${icon} ${temp}°${unit}`;
        } catch(e) { els.weather.innerText = '☀️ --'; }
    };
    updateWeather(); setInterval(updateWeather, 600000);

    // Core Functions
    const setStatus = (txt, pct) => {
        els.status.innerText = txt;
        els.headerStatus.innerText = txt; // Update minimized header status too
        els.progress.style.width = pct + '%';
    };

    const complete = (txt) => {
        setStatus(txt, 100);
        playSound('chime');
        startBlink();
        widget.style.boxShadow = `0 0 25px 5px ${state.config.accent}`;
        state.isRunning = false;
    };

    const stopAll = () => {
        clearTimeout(state.timer); clearTimeout(state.nextCycle);
        state.isRunning = false; state.isPaused = false;
        setStatus("STOPPED", 0);
        widget.style.boxShadow = 'var(--win-shadow)';
    };

    // JKO Logic (From provided code)
    const runJKO = () => {
        state.mode = 'jko'; state.isRunning = true; state.cycle = 0; state.failCount = 0;
        setStatus("INIT", 0);
        playSound('click');
        cycleJKO();
    };
    
    // Expose to window for emoji clicks
    window.runJKOLogic = runJKO;

    const cycleJKO = () => {
        if(!state.isRunning || state.isPaused) return;
        const max = parseInt(widget.querySelector('#s-cyc').value);
        if(state.cycle >= max) { complete("J DONE"); return; }

        setStatus("RUN", (state.cycle/max)*100);
        const t = state.isTurbo ? 800 : (parseInt(widget.querySelector('#s-sec').value)*1000);
        const d = state.isTurbo ? 800 : (parseInt(widget.querySelector('#s-delay').value)*1000);

        try {
            const h = document.getElementsByName("courseheader");
            if(h && h.length > 0) {
                const doc = h[0].contentDocument || h[0].contentWindow.document;
                const b = doc.getElementById('four');
                if(b) {
                    try { API_1484_11.SetValue('cmi.completion_status', 'completed'); API_1484_11.Commit(""); } catch(e){}
                    if(b.href.includes('javascript:')) h[0].contentWindow.location.href = b.href; else b.click();
                    state.cycle++;
                    setStatus(`CYC ${state.cycle}`, (state.cycle/max)*100);
                } else { state.failCount++; }
            }
        } catch(e) { state.failCount++; }

        if(state.failCount > 3) { setStatus("ERROR", 0); stopAll(); return; }

        state.timer = setTimeout(() => {
            state.nextCycle = setTimeout(cycleJKO, d);
        }, t);
    };

    // Cyber Logic
    const runCyber = () => {
        state.mode = 'cyber';
        setStatus("SEARCH", 20);
        let api = null, w = window;
        while(w && !api) {
            if(w.API_1484_11) api = w.API_1484_11;
            else if(w.parent && w.parent !== w) w = w.parent;
            else if(w.opener) w = w.opener;
            else w = null;
        }
        if(api) {
            setStatus("FOUND", 50);
            try {
                api.Initialize(""); 
                api.SetValue("cmi.completion_status", "completed");
                api.SetValue("cmi.success_status", "passed");
                api.Commit(""); 
                api.Terminate("");
                complete("LEAVE");
            } catch(e) { setStatus("ERROR", 0); }
        } else { setStatus("API FAIL", 0); }
    };
    window.runCyberLogic = runCyber;

    // OPSEC Logic
    const runOpsec = () => {
        state.mode = 'opsec';
        setStatus("OPSEC", 50);
        try {
            if(window.opener && window.opener.scorm) {
                window.opener.scorm.set("cmi.score.raw", 100);
                window.opener.scorm.set("cmi.completion_status", "completed");
                window.opener.scorm.set("cmi.success_status", "passed");
                window.opener.scorm.commit();
                complete("LEAVE");
            } else { setStatus("NO OPEN", 0); }
        } catch(e) { setStatus("ERROR", 0); }
    };
    window.runOpsecLogic = runOpsec;

    // Auto Start Logic (From provided code)
    setTimeout(() => {
        let isJKO = false;
        try {
            const h = document.getElementsByName("courseheader");
            if (h && h.length > 0) {
                isJKO = true;
                const d = h[0].contentDocument || h[0].contentWindow.document;
                const startBtn = d.getElementById('one');
                const resumeBtn = d.getElementById('two');
                if (startBtn) { startBtn.click(); setStatus("AUTO START", 10); } 
                else if (resumeBtn) { resumeBtn.click(); setStatus("RESUMED", 10); }
            }
        } catch(e){}

        if (!isJKO) {
            try {
                if (window.opener && window.opener.scorm) {
                    window.opener.scorm.set("cmi.score.raw", 100);
                    window.opener.scorm.set("cmi.completion_status", "completed");
                    window.opener.scorm.set("cmi.success_status", "passed");
                    window.opener.scorm.commit();
                    setStatus("SCORM SET", 100);
                }
            } catch(e) {}
        }

        // Auto Test after 3s if JKO
        setTimeout(() => {
            if(isJKO) {
                setStatus("AUTO TEST", 20);
                try { API_1484_11.SetValue('cmi.completion_status','completed'); setStatus("TEST OK", 100); playSound('chime'); } 
                catch(e) { setStatus("NO API", 0); }
            }
        }, 3000);
    }, 1000);

    // --- EVENT LISTENERS ---
    
    // Buttons
    widget.querySelector('#btn-run-j').addEventListener('click', () => { stopAll(); runJKO(); });
    widget.querySelector('#btn-run-c').addEventListener('click', () => { stopAll(); runCyber(); });
    widget.querySelector('#btn-run-o').addEventListener('click', () => { stopAll(); runOpsec(); });
    widget.querySelector('#btn-test-j').addEventListener('click', () => {
        try { API_1484_11.SetValue('cmi.completion_status','completed'); setStatus("TEST OK", 100); playSound('chime'); } 
        catch(e) { setStatus("NO API", 0); }
    });
    widget.querySelector('#btn-start').addEventListener('click', () => {
        if (state.isPaused) { state.isPaused = false; cycleJKO(); }
        else if (!state.isRunning) runJKO();
    });
    widget.querySelector('#btn-stop').addEventListener('click', stopAll);
    
    // Window Controls
    widget.querySelector('#btn-close').addEventListener('click', () => {
        widget.classList.add('hidden');
        state.isHidden = true;
    });
    widget.querySelector('#btn-minimize').addEventListener('click', () => {
        state.isMinimized = !state.isMinimized;
        widget.classList.toggle('minimized', state.isMinimized);
        els.headerStatus.style.display = state.isMinimized ? 'block' : 'none';
    });
    widget.querySelector('#btn-ghost').addEventListener('click', () => {
        state.isGhost = !state.isGhost; 
        widget.classList.toggle('ghost-mode', state.isGhost);
    });

    // Settings Inputs
    widget.querySelector('#s-sec').onchange = (e) => { state.config.jkoSec = Math.max(1, parseInt(e.target.value)); e.target.value = state.config.jkoSec; saveSettings(); };
    widget.querySelector('#s-delay').onchange = (e) => { state.config.jkoDelay = Math.max(1, parseInt(e.target.value)); e.target.value = state.config.jkoDelay; saveSettings(); };
    widget.querySelector('#s-cyc').onchange = (e) => { state.config.jkoCycles = Math.max(1, parseInt(e.target.value)); e.target.value = state.config.jkoCycles; saveSettings(); };
    widget.querySelector('#s-turbo').onchange = (e) => { state.isTurbo = e.target.checked; saveSettings(); };
    
    widget.querySelector('#s-ghost').oninput = (e) => {
        state.config.ghostOpacity = e.target.value;
        document.documentElement.style.setProperty('--ghost-opacity', e.target.value);
        saveSettings();
    };

    widget.querySelector('#s-dark-ui').onchange = (e) => {
        state.config.darkModeUI = e.target.checked;
        widget.classList.toggle('win-dark-ui', e.target.checked);
        saveSettings();
    };
    widget.querySelector('#s-dark-bg').onchange = (e) => {
        state.config.darkModeBG = e.target.checked;
        document.body.classList.toggle('win-dark-bg', e.target.checked);
        saveSettings();
    };
    
    widget.querySelector('#s-save').onchange = (e) => {
        state.config.saveEnabled = e.target.checked;
        saveSettings();
    };
    
    widget.querySelector('#s-mute').onchange = (e) => {
        state.config.muted = e.target.checked;
        saveSettings();
    };
    
    widget.querySelector('#s-loc-toggle').onchange = (e) => {
        state.config.showLocation = e.target.checked;
        updateWeather();
        saveSettings();
    };
    
    widget.querySelector('#s-color').oninput = (e) => {
        state.config.accent = e.target.value;
        document.documentElement.style.setProperty('--win-accent', e.target.value);
        saveSettings();
    };

    widget.querySelector('#btn-reset-def').addEventListener('click', () => {
        localStorage.removeItem('clippy_win11_config');
        location.reload();
    });

    // Keyboard Shortcuts
    document.addEventListener('keydown', (e) => {
        // Double Space to show hidden widget
        if (e.code === 'Space') {
            const now = Date.now();
            if (state.isHidden && now - state.lastSpacePress < 400) {
                widget.classList.remove('hidden');
                state.isHidden = false;
                state.lastSpacePress = 0;
            } else {
                state.lastSpacePress = now;
            }
        }
        
        if(document.activeElement.tagName === 'INPUT') return;
        const k = e.key.toUpperCase();
        if(k === 'J') { stopAll(); runJKO(); }
        if(k === 'C') { stopAll(); runCyber(); }
        if(k === 'O') { stopAll(); runOpsec(); }
        if(k === 'P') {
            if(state.mode === 'jko') {
                state.isPaused = !state.isPaused;
                setStatus(state.isPaused ? "PAUSED" : "RUNNING", 50);
                if(!state.isPaused) cycleJKO();
            }
        }
        if(k === 'R') { state.cycle = 0; setStatus("RESET", 0); }
        if(k === 'K') { try { API_1484_11.SetValue('cmi.completion_status','completed'); setStatus("CHECKED", 100); } catch(e){} }
        if(k === 'S') { widget.querySelector('.win-nav-btn[data-page="settings"]').click(); }
        if(k === 'L') {
            currentLocationIndex = (currentLocationIndex + 1) % LOCATIONS.length;
            const loc = LOCATIONS[currentLocationIndex];
            // Reset positioning
            widget.style.top = ''; widget.style.bottom = '';
            widget.style.left = ''; widget.style.right = '';
            widget.style.transform = '';
            
            Object.assign(widget.style, loc);
        }
        if(k === 'G') { state.isGhost = !state.isGhost; widget.classList.toggle('ghost-mode', state.isGhost); }
        if(k === 'T') { 
            state.isTurbo = !state.isTurbo; 
            widget.querySelector('#s-turbo').checked = state.isTurbo;
            setStatus(state.isTurbo ? "TURBO" : "NORMAL", 50); 
        }
        if(k === 'V') { 
            let checkbox = widget.querySelector('#s-save');
            checkbox.checked = !checkbox.checked;
            checkbox.dispatchEvent(new Event('change'));
        }
        if(k === 'D') { 
            let uiCheck = widget.querySelector('#s-dark-ui');
            uiCheck.checked = !uiCheck.checked;
            uiCheck.dispatchEvent(new Event('change'));
        }
        if(k === 'H') { stopAll(); state.cycle=0; setStatus("HOME", 0); widget.style.boxShadow='var(--win-shadow)'; stopBlink(); }
    });

    // Drag Logic
    let isDragging = false; let offset = {x:0, y:0};
    const handle = widget.querySelector('#drag-handle');
    
    handle.addEventListener('mousedown', (e) => {
        if(e.target.closest('button')) return;
        isDragging = true;
        offset.x = e.clientX;
        offset.y = e.clientY;
        const rect = widget.getBoundingClientRect();
        widget.style.left = rect.left + 'px';
        widget.style.top = rect.top + 'px';
        widget.style.right = 'auto';
        widget.style.bottom = 'auto';
        widget.style.transform = 'scale(var(--widget-scale))';
    });

    document.addEventListener('mousemove', (e) => {
        if(!isDragging) return;
        widget.style.left = (widget.offsetLeft + (e.clientX - offset.x)) + 'px';
        widget.style.top = (widget.offsetTop + (e.clientY - offset.y)) + 'px';
        offset.x = e.clientX; offset.y = e.clientY;
    });

    document.addEventListener('mouseup', () => isDragging = false);

})();
