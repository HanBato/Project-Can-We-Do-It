    function sanitizeInputs() {
        let sec = parseInt(inputSec.value) || 1;
        let del = parseInt(inputDelay.value) || 1;
        let cyc = parseInt(inputCycles.value) || 1;
        
        if(sec < 1) sec = 1; if(sec > 99) sec = 99;
        if(del < 1) del = 1; if(del > 99) del = 99;
        if(cyc < 1) cyc = 1; if(cyc > 99) cyc = 99;

        inputSec.value = sec; inputDelay.value = del; inputCycles.value = cyc;
    }

    // Enforce limits on input change
    [inputSec, inputDelay, inputCycles].forEach(input => {
        input.addEventListener('change', () => {
            let val = parseInt(input.value);
            if (isNaN(val) || val < 1) input.value = 1;
            if (val > 99) input.value = 99;
        });
