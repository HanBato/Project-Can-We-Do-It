    // --- Draggable Logic ---
    let isDragging = false;
    let dragStartX, dragStartY, initialLeft, initialTop;

    function startDrag(e) {
        if (e.target.closest('button') || e.target.closest('input')) return;
        isDragging = true;
        dragStartX = e.clientX;
        dragStartY = e.clientY;
        
        const rect = container.getBoundingClientRect();
        initialLeft = rect.left;
        initialTop = rect.top;

        container.style.bottom = 'auto';
        container.style.top = initialTop + 'px';
        container.style.left = initialLeft + 'px';
        container.style.transform = 'none';
        
        document.addEventListener('mousemove', drag);
        document.addEventListener('mouseup', stopDrag);
    }

    function drag(e) {
        if (!isDragging) return;
        const dx = e.clientX - dragStartX;
        const dy = e.clientY - dragStartY;
        
        let newLeft = initialLeft + dx;
        let newTop = initialTop + dy;

        const rect = container.getBoundingClientRect();
        const maxX = window.innerWidth - rect.width;
        const maxY = window.innerHeight - rect.height;

        newLeft = Math.max(0, Math.min(newLeft, maxX));
        newTop = Math.max(0, Math.min(newTop, maxY));

        container.style.left = newLeft + 'px';
        container.style.top = newTop + 'px';
    }

    function stopDrag() {
        isDragging = false;
        document.removeEventListener('mousemove', drag);
        document.removeEventListener('mouseup', stopDrag);
    }

    titleBar.addEventListener('mousedown', startDrag);

    // --- Time & Age Logic ---
    function updateTimes() {
        const now = new Date();
        const months = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
        
        // Date (Center)
        const dayStr = String(now.getDate()).padStart(2, '0');
        const monthStr = months[now.getMonth()];
        const yearStr = String(now.getFullYear()).slice(-2);
        menuDate.innerText = `${dayStr}/${monthStr}/${yearStr}`;

        // Time (Right) - Format: HH:MM:SS[Z:HH]
        const h = String(now.getHours()).padStart(2, '0');
        const m = String(now.getMinutes()).padStart(2, '0');
        const s = String(now.getSeconds()).padStart(2, '0');
        const zH = String(now.getUTCHours()).padStart(2, '0');
        menuClock.innerText = `${h}:${m}:${s}[Z:${zH}]`;

        // Age
        const diff = Date.now() - uiStartTime;
        const d = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hrs = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const secs = Math.floor((diff % (1000 * 60)) / 1000);
        textAge.innerText = `${String(d).padStart(2, '0')}d ${String(hrs).padStart(2, '0')}h ${String(mins).padStart(2, '0')}m ${String(secs).padStart(2, '0')}s`;
    }

    setInterval(updateTimes, 1000);
    updateTimes(); 

    // --- Weather Logic ---
    async function fetchWeather() {
        try {
            const response = await fetch('https://wttr.in/?format=j1');
            const data = await response.json();
            const condition = data.current_condition[0];
            const temp = condition.temp_F;
            const desc = condition.weatherDesc[0].value.toLowerCase();
            
            let icon = '☀️';
            if (desc.includes('rain') || desc.includes('shower')) icon = '🌧️';
            else if (desc.includes('cloud') || desc.includes('overcast')) icon = '☁️';
            else if (desc.includes('partly')) icon = '🌤️';
            else if (desc.includes('clear') && menuClock.innerText.startsWith('2')) icon = '🌕'; 

            menuWeather.innerText = `${icon} ${temp}°F`;
        } catch (e) {
            menuWeather.innerText = '☀️ --°F';
        }
    }

    // --- Helper Functions ---
    function applyTheme() {
        // Logic from provided Apple-style script
        const filterStr = isDarkMode ? "invert(1) hue-rotate(180deg)" : "none";
        
        // Apply to main document
        document.documentElement.style.filter = filterStr;
        
        // Apply to iframes (JKO specific)
        document.querySelectorAll('iframe').forEach(f => {
            try { 
                if(f.contentDocument && f.contentDocument.documentElement) {
                    f.contentDocument.documentElement.style.filter = filterStr; 
                }
            } catch(e) {}
        });
        
        // We specifically DO NOT apply the filter to the UI container (#jko-bug-tester-ui)
        // to keep the UI looking like Windows XP as requested.
    }

