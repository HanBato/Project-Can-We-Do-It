    function saveSettings() {
        const saveEnabled = localStorage.getItem('jko_save_enabled') === 'true';
        if (!saveEnabled) return;

        const config = {
            sec: inputSec.value,
            delay: inputDelay.value,
            cycles: inputCycles.value,
