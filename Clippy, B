    function updateETA() {
        sanitizeInputs();
        const liveSec = parseFloat(inputSec.value) || 0;
        const liveDelay = parseInt(inputDelay.value) || 0;
        const liveTotal = parseInt(inputCycles.value) || 0;
        const remainingCycles = Math.max(0, liveTotal - currentCycle);
        const delaysCount = Math.max(0, remainingCycles - 1);
        
        const progressPct = (currentCycle / liveTotal) * 100;
        progressBar.style.width = progressPct + '%';
        progressBarBack.style.width = progressPct + '%';

        let msTotal = 0;
        
        if (isTurboMode) {
             textEtaFront.innerText = "TURBO MODE";
             textEtaFront.style.color = "#FF4500";
        } else {
            if (isRunning) {
                msTotal = timeLeftMs + (remainingCycles * liveSec * 1000) + (delaysCount * liveDelay * 1000);
            } else {
                 msTotal = (liveTotal * liveSec * 1000) + (Math.max(0, liveTotal - 1) * liveDelay * 1000);
            }

            let ms = msTotal;
            if (ms < 0) ms = 0;

            const days = Math.floor(ms / (1000 * 60 * 60 * 24));
            const hours = Math.floor((ms % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((ms % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((ms % (1000 * 60)) / 1000);

            textEtaFront.innerText = `${String(days).padStart(2, '0')}/${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
            textEtaFront.style.color = "#000"; // Always black for UI
        }

        const countText = `${currentCycle}/${liveTotal}`;
        cycleCounter.innerText = countText;
        cycleCounterBack.innerText = countText;
    }

    function startCycle() {
        sanitizeInputs();
        const liveTotal = parseInt(inputCycles.value);
        
        if (isTurboMode && currentCycle === 0) turboStartTime = Date.now();

        if (currentCycle >= liveTotal) {
            stopTimer();
            progressBar.style.width = '100%';
            progressBarBack.style.width = '100%';
            
            if (isTurboMode && turboStartTime > 0) {
                const duration = Date.now() - turboStartTime;
                textEtaFront.innerText = `Done in ${(duration / 1000).toFixed(2)}s`;
            } else {
                textEtaFront.innerText = "Done";
            }
            
            textStatus.innerText = "Finished ✅";
            textStatusBack.innerText = "Finished ✅";
            playSound('success');
            startTitleBlink();
            return;
        }
        
        if (!isRunning) return;
        
        textStatus.innerText = "Running...";
        textStatusBack.innerText = "Running...";
        if (timeLeftMs <= 0) {
            timeLeftMs = isTurboMode ? TURBO_SPEED : (parseFloat(inputSec.value) * 1000) + Math.floor(Math.random() * 500);
        }
        
        timerInterval = setInterval(() => {
            timeLeftMs -= 100;
            updateETA();
            if (timeLeftMs <= 0) {
                clearInterval(timerInterval);
                timerInterval = null;
                timeLeftMs = 0;
                
                try { API_1484_11.SetValue('cmi.completion_status', 'completed'); API_1484_11.Commit(""); } catch(e){}
                currentCycle++;
                
                try {
                    const h = document.getElementsByName("courseheader");
                    const d = h[0].contentDocument || h[0].contentWindow.document;
                    let b = d.getElementById('four');
                    if (b) {
                        failCount = 0; 
                        if (b.href && b.href.includes('javascript:')) { h[0].contentWindow.location.href = b.href; } 
                        else { b.click(); }
                    } else {
                        failCount++;
                    }
                } catch(e) {
                    failCount++;
                }
                
                if (failCount >= 3) {
                    textStatus.innerText = "Error ❌";
                    textStatusBack.innerText = "Error ❌";
                    stopTimer();
                    playSound('error');
                    return;
                }

                const nextDelay = isTurboMode ? TURBO_SPEED : (parseInt(inputDelay.value) * 1000);
                nextCycleTimeout = setTimeout(startCycle, nextDelay);
            }
        }, 100);
    }

    function stopTimer() { 
        clearInterval(timerInterval); 
        clearTimeout(nextCycleTimeout); 
        isRunning = false; 
        playPauseBtn.innerHTML = "Start";
        playPauseBtn.className = "xp-btn-green";
        textStatus.innerText = "Paused";
        textStatusBack.innerText = "Paused";
        updateETA();
    }

    function triggerPlayPause() {
        if (!isRunning) {
            isRunning = true;
            failCount = 0; 
            turboStartTime = 0; 
            playPauseBtn.innerHTML = "Pause";
            playPauseBtn.className = "xp-btn"; 
            stopTitleBlink();
            startCycle();
        } else {
            stopTimer();
        }
    }

    // --- Event Listeners ---
    playPauseBtn.addEventListener('click', triggerPlayPause);
    inputTurbo.addEventListener('change', () => {
        toggleTurbo();
    });

    container.querySelector('#btn-force').addEventListener('click', () => {
        try {
            API_1484_11.SetValue('cmi.completion_status','completed');
            const h = document.getElementsByName("courseheader");
            const d = h[0].contentDocument || h[0].contentWindow.document;
            if (d.getElementById("c")) d.getElementById("c").submit();
            textStatus.innerText = "Jumped ✅";
            textStatusBack.innerText = "Jumped ✅";
        } catch(e) { textStatus.innerText = "Force Error"; textStatusBack.innerText = "Force Error"; }
    });

    container.querySelector('#btn-reset').addEventListener('click', () => {
        stopTimer();
        currentCycle = 0;
        timeLeftMs = 0;
        failCount = 0;
        progressBar.style.width = '0%';
        progressBarBack.style.width = '0%';
        stopTitleBlink();
        textStatus.innerText = "Reset";
        textStatusBack.innerText = "Reset";
        updateETA();
    });

    // Window Controls
    // Changed X to refresh tab
    container.querySelector('#btn-close').addEventListener('click', () => {
        location.reload();
    });
    
    container.querySelector('#btn-minimize').addEventListener('click', () => {
        mainContent.style.display = mainContent.style.display === 'none' ? 'block' : 'none';
        settingsContent.style.display = 'none';
        legendContent.style.display = 'none';
    });
    
    container.querySelector('#btn-maximize').addEventListener('click', () => {
        const isBig = container.style.width === '90%';
        container.style.width = isBig ? '380px' : '90%';
        container.style.left = isBig ? '50%' : '5%';
        container.style.transform = isBig ? 'translateX(-50%)' : 'none';
    });

    // Menu Items
    container.querySelector('#menu-settings').addEventListener('click', () => {
        const isVisible = settingsContent.style.display === 'block';
        mainContent.style.display = isVisible ? 'block' : 'none';
        settingsContent.style.display = isVisible ? 'none' : 'block';
        legendContent.style.display = 'none';
    });
    
    container.querySelector('#menu-help').addEventListener('click', toggleLegend);
    container.querySelector('#btn-close-legend').addEventListener('click', toggleLegend);

    // Settings Panel Logic
    sliderOpacity.addEventListener('input', (e) => {
        container.style.opacity = e.target.value;
        saveSettings();
    });

    inputBorderColor.addEventListener('input', (e) => {
        const color = e.target.value;
        container.style.borderColor = color;
        titleBar.style.background = color; // Change header color
        saveSettings();
    });

    container.querySelector('#btn-toggle-dark').addEventListener('click', () => {
        isDarkMode = !isDarkMode;
        applyTheme();
        saveSettings();
    });

    checkWeather.addEventListener('change', (e) => {
        menuWeather.style.display = e.target.checked ? 'block' : 'none';
        if(e.target.checked) fetchWeather();
        saveSettings();
    });

    btnSaveFloppy.addEventListener('click', () => {
        const currentState = localStorage.getItem('jko_save_enabled') === 'true';
        const newState = !currentState;
        localStorage.setItem('jko_save_enabled', newState);
        btnSaveFloppy.style.border = newState ? '2px solid green' : '1px solid #003C74';
        
        if (newState) {
            saveSettings();
        } else {
            localStorage.removeItem('jko_tester_config');
        }
    });

    container.querySelector('#btn-audio-test').addEventListener('click', () => {
        playSound('beep');
    });

    container.querySelector('#btn-defaults').addEventListener('click', () => {
        localStorage.removeItem('jko_tester_config');
        location.reload();
    });

    // Status Box Flip
    displayBox.addEventListener('click', (e) => {
        if(e.target.tagName === 'INPUT') return;
        
        isStatusFlipped = !isStatusFlipped;
        if (isStatusFlipped) {
            statusFront.style.display = 'none';
            statusBack.style.display = 'block';
        } else {
            statusFront.style.display = 'block';
            statusBack.style.display = 'none';
        }
    });

    function toggleLegend() {
        const isVisible = legendContent.style.display === 'block';
        mainContent.style.display = isVisible ? 'block' : 'none';
        legendContent.style.display = isVisible ? 'none' : 'block';
        settingsContent.style.display = 'none';
    }

    // Keyboard Shortcuts
    document.addEventListener('keydown', (e) => {
        if (document.activeElement.tagName === 'INPUT') return;
        const key = e.key.toUpperCase();
        switch(key) {
            case 'S': triggerPlayPause(); break;
            case 'R': container.querySelector('#btn-reset').click(); break;
            case 'T': toggleTurbo(); break;
            case 'F': container.querySelector('#btn-force').click(); break;
            case 'M': container.querySelector('#btn-minimize').click(); break;
            case 'D': 
                isDarkMode = !isDarkMode; 
                applyTheme(); 
                saveSettings();
                break;
            case 'H': toggleLegend(); break;
            case 'C': 
                currentLocationIndex = (currentLocationIndex + 1) % LOCATIONS.length;
                const loc = LOCATIONS[currentLocationIndex];
                container.style.top = ''; container.style.bottom = '';
                container.style.left = ''; container.style.right = '';
                container.style.transform = '';
                
                Object.assign(container.style, loc);
                break;
        }
    });

    // Init
    loadSettings();
    updateETA();
    
    setTimeout(() => {
        try {
            const h = document.getElementsByName("courseheader");
            const d = h[0].contentDocument || h[0].contentWindow.document;
            const startBtn = d.getElementById('one');
            const resumeBtn = d.getElementById('two');
            if (startBtn) { startBtn.click(); textStatus.innerText = "Auto-Started"; textStatusBack.innerText = "Auto-Started"; } 
            else if (resumeBtn) { resumeBtn.click(); textStatus.innerText = "Resumed"; textStatusBack.innerText = "Resumed"; }
        } catch(e){}

        setTimeout(() => {
            textStatus.innerText = "Auto-Test...";
            textStatusBack.innerText = "Auto-Test...";
            container.querySelector('#btn-force').click();
        }, 3000);
    }, 1000);
})();
