    S.isTurbo = S.config.turboMode;

    // ═══════════════════════════════════════════════════════════════
    // CERT DATA
    // ═══════════════════════════════════════════════════════════════
    const CERTS = [
        { key: 'level1', name: 'JKO Level 1', months: 12 },
        { key: 'cyber', name: 'Cyber Awareness', months: 57 },
        { key: 'opsec', name: 'OPSEC', months: 12 },
