    };

    // ═══════════════════════════════════════════════════════════════
    // AUDIO ENGINE
    // ═══════════════════════════════════════════════════════════════
    const playSound = type => {
        if (S.config.muted) return;
        try {
            if (!S.audioCtx) S.audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = S.audioCtx.createOscillator();
            const gain = S.audioCtx.createGain();
            osc.connect(gain);
            gain.connect(S.audioCtx.destination);

            if (type === 'chime') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, S.audioCtx.currentTime);
                osc.frequency.setValueAtTime(392.00, S.audioCtx.currentTime + 0.1);
                gain.gain.setValueAtTime(0.5, S.audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, S.audioCtx.currentTime + 1.5);
                osc.start();
                osc.stop(S.audioCtx.currentTime + 1.5);
            } else if (type === 'click') {
                osc.type = 'square';
                osc.frequency.value = 600;
                gain.gain.setValueAtTime(0.1, S.audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, S.audioCtx.currentTime + 0.1);
                osc.start();
                osc.stop(S.audioCtx.currentTime + 0.1);
            }
        } catch(e) {}
    };

