    // ═══════════════════════════════════════════════════════════════
    const $ = id => document.getElementById(id);
    const pad = n => String(n).padStart(2, '0');
    
    const hms = ms => {
        const s = Math.floor(ms / 1000);
        return `${pad(Math.floor(s/3600))}:${pad(Math.floor((s%3600)/60))}:${pad(s%60)}`;
    };

    const fmtDate = d => {
        const mon = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
        return `${pad(d.getDate())}${mon[d.getMonth()]}${String(d.getFullYear()).slice(2)}`;
    };

    const getDue = (months, sub) => {
        const d = new Date();
        d.setMonth(d.getMonth() + months);
        if (sub) d.setDate(d.getDate() - 1);
        return d;
    };

    const parseDate = str => {
        if (!str || str === 'Not set') return null;
        const mon = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
        const m = mon.indexOf(str.slice(2, 5));
        if (m === -1) return null;
        return new Date(2000 + parseInt(str.slice(5)), m, parseInt(str.slice(0, 2)));
    };

    const certColor = due => {
        if (!due) return { bg: '#f0f0f0', text: '#888', label: 'Not set' };
        const days = Math.ceil((due - new Date()) / 86400000);
        if (days < 0) return { bg: '#fde8e8', text: '#9b1c1c', label: `${fmtDate(due)} ⚠` };
        if (days <= 90) return { bg: '#fff8e1', text: '#7a5a00', label: fmtDate(due) };
        return { bg: '#e6f9ee', text: '#1a7a3c', label: fmtDate(due) };
    };

    const saveSettings = () => {
        if (S.config.saveEnabled) {
            localStorage.setItem('clippy_pilot_config', JSON.stringify(S.config));
