    `;

    document.body.appendChild(root);
    document.body.style.paddingTop = '42px';

    // ═══════════════════════════════════════════════════════════════
    // ELEMENT REFERENCES
    // ═══════════════════════════════════════════════════════════════
    const EL = {
        statusText: $('statusText'),
        statusProgress: $('statusProgress'),
        panelProgress: $('panelProgress'),
        pillPing: $('pillPing'),
        pillCount: $('pillCount'),
        dotG: $('dotG'),
        dotR: $('dotR'),
        dotY: $('dotY'),
        uptimeClock: $('uptimeClock'),
        wIcon: $('wIcon'),
        wVal: $('wVal'),
        wTip: $('wTip'),
        netUp: $('netUp'),
        netDown: $('netDown'),
        netPing: $('netPing'),
        netWeather: $('netWeather'),
        kbdGrid: $('kbdGrid'),
        copyHint: $('copyHint'),
        certList: $('certList'),
        panel: $('cp-panel'),
        boxSec: $('boxSec'),
        boxDelay: $('boxDelay'),
        boxCycles: $('boxCycles')
    };

    // ═══════════════════════════════════════════════════════════════
    // STATUS & PROGRESS FUNCTIONS
    // ═══════════════════════════════════════════════════════════════
    const setStatus = (txt, pct = 0) => {
        EL.statusText.textContent = txt;
        EL.statusProgress.style.width = pct + '%';
        EL.panelProgress.style.width = pct + '%';
    };

    const setDots = state => {
        if (state === 'run') {
            EL.dotG.style.opacity = '1';
            EL.dotR.style.opacity = '0.25';
        } else if (state === 'stop') {
            EL.dotG.style.opacity = '0.25';
            EL.dotR.style.opacity = '1';
        } else {
            EL.dotG.style.opacity = '0.3';
            EL.dotR.style.opacity = '0.3';
        }
    };

    const complete = txt => {
        setStatus(txt, 100);
        playSound('chime');
        startBlink();
        root.style.boxShadow = `0 0 30px 5px ${S.config.accent}`;
        S.isRunning = false;
    };

    const stopAll = () => {
        clearTimeout(S.timer);
        clearTimeout(S.nextCycle);
        S.isRunning = false;
        S.isPaused = false;
        setStatus('STOPPED', 0);
        setDots('stop');
        root.style.boxShadow = 'none';
    };

    // ═══════════════════════════════════════════════════════════════
    // JKO AUTOMATION
    // ═══════════════════════════════════════════════════════════════
    const runJKO = () => {
        S.mode = 'jko';
        S.isRunning = true;
        S.cycle = 0;
        S.failCount = 0;
        setStatus('INIT', 0);
        playSound('click');
        cycleJKO();
    };

    const cycleJKO = () => {
        if (!S.isRunning || S.isPaused) return;
        
        const max = parseInt(EL.boxCycles.value) || 20;
        if (S.cycle >= max) {
            complete('J DONE');
            return;
        }

        setStatus('RUN', (S.cycle / max) * 100);
        const t = S.isTurbo ? 800 : (parseInt(EL.boxSec.value) || 3) * 1000;
        const d = S.isTurbo ? 800 : (parseInt(EL.boxDelay.value) || 2) * 1000;

        try {
            const h = document.getElementsByName('courseheader');
            if (h && h.length > 0) {
                const doc = h[0].contentDocument || h[0].contentWindow.document;
                const b = doc.getElementById('four');
                if (b) {
                    try {
                        API_1484_11.SetValue('cmi.completion_status', 'completed');
                        API_1484_11.Commit('');
                    } catch(e) {}
                    if (b.href.includes('javascript:')) {
                        h[0].contentWindow.location.href = b.href;
                    } else {
                        b.click();
                    }
                    S.cycle++;
                    setStatus(`CYC ${S.cycle}`, (S.cycle / max) * 100);
                } else {
                    S.failCount++;
                }
            }
        } catch(e) {
            S.failCount++;
        }

        if (S.failCount > 3) {
            setStatus('ERROR', 0);
            stopAll();
            return;
        }

        S.timer = setTimeout(() => {
            S.nextCycle = setTimeout(cycleJKO, d);
        }, t);
    };

    // ═══════════════════════════════════════════════════════════════
    // CYBER AUTOMATION
    // ═══════════════════════════════════════════════════════════════
    const runCyber = () => {
        S.mode = 'cyber';
        setStatus('SEARCH', 20);
        
        let api = null;
        let w = window;
        
        while (w && !api) {
            if (w.API_1484_11) api = w.API_1484_11;
            else if (w.parent && w.parent !== w) w = w.parent;
            else if (w.opener) w = w.opener;
            else w = null;
        }

        if (api) {
            setStatus('FOUND', 50);
            try {
                api.Initialize('');
                api.SetValue('cmi.completion_status', 'completed');
                api.SetValue('cmi.success_status', 'passed');
                api.Commit('');
                api.Terminate('');
                complete('LEAVE');
            } catch(e) {
                setStatus('ERROR', 0);
            }
        } else {
            setStatus('API FAIL', 0);
        }
    };

    // ═══════════════════════════════════════════════════════════════
    // OPSEC AUTOMATION
    // ═══════════════════════════════════════════════════════════════
    const runOpsec = () => {
        S.mode = 'opsec';
        setStatus('OPSEC', 50);
        
        try {
            if (window.opener && window.opener.scorm) {
                window.opener.scorm.set('cmi.score.raw', 100);
                window.opener.scorm.set('cmi.completion_status', 'completed');
                window.opener.scorm.set('cmi.success_status', 'passed');
                window.opener.scorm.commit();
                complete('LEAVE');
            } else {
                setStatus('NO OPEN', 0);
            }
        } catch(e) {
            setStatus('ERROR', 0);
        }
    };

    // ═══════════════════════════════════════════════════════════════
    // TEST API
    // ═══════════════════════════════════════════════════════════════
    const testAPI = () => {
        try {
            API_1484_11.SetValue('cmi.completion_status', 'completed');
            setStatus('TEST OK', 100);
            playSound('chime');
        } catch(e) {
            setStatus('NO API', 0);
        }
    };

    // ═══════════════════════════════════════════════════════════════
    // AUTO START LOGIC
    // ═══════════════════════════════════════════════════════════════
    setTimeout(() => {
        let isJKO = false;
        try {
            const h = document.getElementsByName('courseheader');
            if (h && h.length > 0) {
                isJKO = true;
                const d = h[0].contentDocument || h[0].contentWindow.document;
                const startBtn = d.getElementById('one');
                const resumeBtn = d.getElementById('two');
                if (startBtn) {
                    startBtn.click();
                    setStatus('AUTO START', 10);
                } else if (resumeBtn) {
                    resumeBtn.click();
                    setStatus('RESUMED', 10);
                }
            }
        } catch(e) {}

        if (!isJKO) {
            try {
                if (window.opener && window.opener.scorm) {
                    window.opener.scorm.set('cmi.score.raw', 100);
                    window.opener.scorm.set('cmi.completion_status', 'completed');
                    window.opener.scorm.set('cmi.success_status', 'passed');
                    window.opener.scorm.commit();
                    setStatus('SCORM SET', 100);
                }
            } catch(e) {}
        }

        setTimeout(() => {
            if (isJKO) {
                setStatus('AUTO TEST', 20);
                try {
                    API_1484_11.SetValue('cmi.completion_status', 'completed');
                    setStatus('TEST OK', 100);
                    playSound('chime');
                } catch(e) {
                    setStatus('NO API', 0);
                }
            }
        }, 3000);
    }, 1000);

    // ═══════════════════════════════════════════════════════════════
    // UPTIME CLOCK
    // ═══════════════════════════════════════════════════════════════
    setInterval(() => {
        const elapsed = Date.now() - S.uptimeStart;
        EL.uptimeClock.textContent = hms(elapsed);
        
        // Activity blink
        EL.dotY.style.opacity = (Math.floor(elapsed / 500) % 2 === 0) ? '1' : '0.35';
    }, 500);

    // ═══════════════════════════════════════════════════════════════
    // WEATHER
    // ═══════════════════════════════════════════════════════════════
    let tempMode = S.config.weatherUnit === 'F' ? 'F' : 'C';

    const showWeather = () => {
        if (!S.weather.tempF) {
            EL.wVal.textContent = '--';
            EL.wIcon.textContent = '⏳';
            EL.netWeather.textContent = '--';
            return;
        }

        let val, tip;
        if (tempMode === 'F') {
            val = `${S.weather.tempF}°F`;
            tip = `${S.weather.desc} — click for °C`;
        } else {
            val = `${S.weather.tempC}°C`;
            tip = `${S.weather.desc} — click for °F`;
        }

        EL.wVal.textContent = val;
        EL.wIcon.textContent = S.weather.icon;
        EL.wTip.textContent = tip;
        EL.netWeather.textContent = val;
    };

    const cycleTemp = () => {
        tempMode = tempMode === 'F' ? 'C' : 'F';
        showWeather();
    };

    const fetchWeather = async () => {
        try {
            const r = await fetch('https://wttr.in/?format=j1');
            const j = await r.json();
            const c = j.current_condition[0];
            
            S.weather.tempC = c.temp_C;
            S.weather.tempF = c.temp_F;
            S.weather.feelsC = c.FeelsLikeC;
            S.weather.feelsF = c.FeelsLikeF;
            
                        const desc = c.weatherDesc[0].value.toLowerCase();
            if (desc.includes('rain')) S.weather.icon = '🌧';
            else if (desc.includes('cloud')) S.weather.icon = '☁';
            else if (desc.includes('clear') && (new Date().getHours() > 20 || new Date().getHours() < 6)) S.weather.icon = '🌙';
            else if (desc.includes('clear')) S.weather.icon = '☀';
            else if (desc.includes('snow')) S.weather.icon = '❄';
            else if (desc.includes('storm') || desc.includes('thunder')) S.weather.icon = '🌩';
            else S.weather.icon = '☀';
            
            S.weather.desc = c.weatherDesc[0].value;
            showWeather();
        } catch(e) {
            EL.wVal.textContent = '😞';
            EL.netWeather.textContent = '😞';
        }
    };

    fetchWeather();
    setInterval(fetchWeather, 600000);

    // ═══════════════════════════════════════════════════════════════
    // NETWORK MEASUREMENT
    // ═══════════════════════════════════════════════════════════════
    const measureNetwork = async () => {
        const t0 = performance.now();
        try {
            await fetch('https://www.cloudflare.com/cdn-cgi/trace?t=' + Math.random(), { cache: 'no-store' });
            const ping = Math.round(performance.now() - t0);
            
            EL.pillPing.textContent = ping + 'ms';
            EL.netPing.textContent = ping + 'ms';
            
            // Simulated speeds (replace with real speed test if needed)
            const down = (Math.random() * 90 + 20).toFixed(1);
            const up = (Math.random() * 35 + 5).toFixed(1);
            EL.netDown.textContent = down + ' Mb';
            EL.netUp.textContent = up + ' Mb';
        } catch(e) {
            EL.pillPing.textContent = '😞';
            EL.netPing.textContent = '😞';
        }
    };

    measureNetwork();
    setInterval(measureNetwork, 30000);

    // ═══════════════════════════════════════════════════════════════
    // KEYBOARD SHORTCUTS GRID
    // ═══════════════════════════════════════════════════════════════
    KEYS.forEach(k => {
        const item = document.createElement('div');
        item.className = 'kbd-item';
        item.innerHTML = `<span class="kbd-key">${k.key}</span><span class="kbd-desc">${k.desc}</span>`;
        item.onclick = () => {
            try {
                navigator.clipboard.writeText(`${k.key} — ${k.desc}`);
            } catch(e) {}
            item.classList.add('copied');
            EL.copyHint.textContent = '✓ ' + k.key;
            setTimeout(() => {
                item.classList.remove('copied');
                EL.copyHint.textContent = '';
            }, 1100);
        };
        EL.kbdGrid.appendChild(item);
    });

    // ═══════════════════════════════════════════════════════════════
    // CERT TRACKER
    // ═══════════════════════════════════════════════════════════════
    const buildCerts = () => {
        EL.certList.innerHTML = '';
        
        CERTS.forEach(cert => {
            const row = document.createElement('div');
            row.className = 'cert-row';
            
            const saved = S.certDates[cert.key];
            const due = saved ? parseDate(saved) : null;
            const color = certColor(due);
            
            row.innerHTML = `
                <span class="cert-name">${cert.name}</span>
                <span class="cert-months">${cert.months}mo</span>
                <span class="cert-due" style="background:${color.bg};color:${color.text};">${color.label}</span>
                <button class="save-cert" data-key="${cert.key}" title="Save today as completion">💾</button>
            `;
            
            EL.certList.appendChild(row);
        });

        // Bind save buttons
        EL.certList.querySelectorAll('.save-cert').forEach(btn => {
            btn.addEventListener('click', () => {
                const key = btn.dataset.key;
                const cert = CERTS.find(c => c.key === key);
                const due = getDue(cert.months, true);
                const str = fmtDate(due);
                
                S.certDates[key] = str;
                saveCerts();
                
                // Update display
                const span = btn.parentElement.querySelector('.cert-due');
                const color = certColor(due);
                span.style.background = color.bg;
                span.style.color = color.text;
                span.textContent = color.label;
                
                btn.textContent = '✓';
                setTimeout(() => btn.textContent = '💾', 900);
                playSound('click');
            });
        });
    };

    buildCerts();

    // ═══════════════════════════════════════════════════════════════
    // PANEL TOGGLE
    // ═══════════════════════════════════════════════════════════════
    const togglePanel = () => {
        S.panelOpen = !S.panelOpen;
        EL.panel.classList.toggle('open', S.panelOpen);
        playSound('click');
    };

    // ═══════════════════════════════════════════════════════════════
    // DARK MODE
    // ═══════════════════════════════════════════════════════════════
    const toggleDark = () => {
        S.config.darkMode = !S.config.darkMode;
        root.classList.toggle('dark', S.config.darkMode);
        
        const tog = $('togDark');
        tog.classList.toggle('on', S.config.darkMode);
        tog.innerHTML = `${S.config.darkMode ? '☀' : '☾'}<span class="tog-tip">Dark [D]</span>`;
        
        saveSettings();
        playSound('click');
    };

    // ═══════════════════════════════════════════════════════════════
    // TURBO MODE
    // ═══════════════════════════════════════════════════════════════
    const toggleTurbo = () => {
        S.isTurbo = !S.isTurbo;
        S.config.turboMode = S.isTurbo;
        root.classList.toggle('turbo', S.isTurbo);
        
        const tog = $('togTurbo');
        tog.classList.toggle('on', S.isTurbo);
        
        saveSettings();
        setStatus(S.isTurbo ? 'TURBO' : 'NORMAL', 50);
        playSound('click');
    };

    // ═══════════════════════════════════════════════════════════════
    // GHOST MODE
    // ═══════════════════════════════════════════════════════════════
    const toggleGhost = () => {
        S.isGhost = !S.isGhost;
        root.classList.toggle('ghost-mode', S.isGhost);
        playSound('click');
    };

    // ═══════════════════════════════════════════════════════════════
    // SOUND TOGGLE
    // ═══════════════════════════════════════════════════════════════
    const toggleSound = () => {
        S.config.muted = !S.config.muted;
        
        const tog = $('togSound');
        tog.classList.toggle('on', !S.config.muted);
        tog.innerHTML = `${S.config.muted ? '🔇' : '🔊'}<span class="tog-tip">Sound</span>`;
        
        saveSettings();
    };

    // ═══════════════════════════════════════════════════════════════
    // SAVE TOGGLE
    // ═══════════════════════════════════════════════════════════════
    const toggleSave = () => {
        S.config.saveEnabled = !S.config.saveEnabled;
        
        const tog = $('togSave');
        tog.classList.toggle('on', S.config.saveEnabled);
        
        saveSettings();
        playSound('click');
    };

    // ═══════════════════════════════════════════════════════════════
    // POSITION CYCLING
    // ═══════════════════════════════════════════════════════════════
    const LOCATIONS = [
        { top: '0', left: '0', right: 'auto', bottom: 'auto' },
        { top: '0', right: '0', left: 'auto', bottom: 'auto' },
        { top: 'auto', right: '0', left: 'auto', bottom: '0' },
        { top: 'auto', left: '0', right: 'auto', bottom: '0' }
    ];
    let locationIndex = 0;

    const cyclePosition = () => {
        locationIndex = (locationIndex + 1) % LOCATIONS.length;
        const loc = LOCATIONS[locationIndex];
        
        const header = $('cp-header');
        Object.keys(loc).forEach(k => {
            header.style[k] = loc[k] === 'auto' ? 'auto' : loc[k];
        });
        
        // Adjust panel position
        if (loc.right === '0') {
            EL.panel.style.right = 'auto';
            EL.panel.style.left = '0';
            EL.panel.style.transform = S.panelOpen ? 'translateX(0)' : 'translateX(-100%)';
        } else {
            EL.panel.style.left = 'auto';
            EL.panel.style.right = '0';
            EL.panel.style.transform = S.panelOpen ? 'translateX(0)' : 'translateX(100%)';
        }
        
        playSound('click');
    };

    // ═══════════════════════════════════════════════════════════════
    // START / STOP HANDLERS
    // ═══════════════════════════════════════════════════════════════
    const handleStart = () => {
        if (S.isPaused) {
            S.isPaused = false;
            cycleJKO();
        } else if (!S.isRunning) {
            runJKO();
        }
        S.activeCount++;
        EL.pillCount.textContent = S.activeCount;
        setDots('run');
    };

    const handleStop = () => {
        stopAll();
    };

    const handleReset = () => {
        stopAll();
        S.cycle = 0;
        setStatus('RESET', 0);
        root.style.boxShadow = 'none';
        stopBlink();
        playSound('click');
    };

    const handleJump = () => {
        runJKO();
    };

    // ═══════════════════════════════════════════════════════════════
    // EVENT LISTENERS - BUTTONS
    // ═══════════════════════════════════════════════════════════════
    $('btnStart').addEventListener('click', handleStart);
    $('btnStop').addEventListener('click', handleStop);
    $('btnReset').addEventListener('click', handleReset);
    $('btnJump').addEventListener('click', handleJump);
    $('btnPanel').addEventListener('click', togglePanel);
    $('btnPanelClose').addEventListener('click', togglePanel);
    $('brandBtn').addEventListener('click', togglePanel);
    $('weatherBtn').addEventListener('click', cycleTemp);

    $('btnRunJ').addEventListener('click', () => { stopAll(); runJKO(); });
    $('btnRunC').addEventListener('click', () => { stopAll(); runCyber(); });
    $('btnRunO').addEventListener('click', () => { stopAll(); runOpsec(); });
    $('btnTest').addEventListener('click', testAPI);

    $('togSave').addEventListener('click', toggleSave);
    $('togTurbo').addEventListener('click', toggleTurbo);
    $('togTemp').addEventListener('click', cycleTemp);
    $('togSound').addEventListener('click', toggleSound);
    $('togDark').addEventListener('click', toggleDark);

    // Settings inputs
    EL.boxSec.onchange = e => {
        S.config.jkoSec = Math.max(1, parseInt(e.target.value) || 3);
        e.target.value = S.config.jkoSec;
        saveSettings();
    };

    EL.boxDelay.onchange = e => {
        S.config.jkoDelay = Math.max(1, parseInt(e.target.value) || 2);
        e.target.value = S.config.jkoDelay;
        saveSettings();
    };

    EL.boxCycles.onchange = e => {
        S.config.jkoCycles = Math.max(1, parseInt(e.target.value) || 20);
        e.target.value = S.config.jkoCycles;
        saveSettings();
    };

    // ═══════════════════════════════════════════════════════════════
    // KEYBOARD SHORTCUTS
    // ═══════════════════════════════════════════════════════════════
    document.addEventListener('keydown', e => {
        if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) return;

        const k = e.key.toUpperCase();

        if (e.code === 'Space') {
            e.preventDefault();
            S.isRunning ? handleStop() : handleStart();
        }
        else if (k === 'R') handleReset();
        else if (k === 'J') { stopAll(); runJKO(); }
        else if (k === 'C') { stopAll(); runCyber(); }
        else if (k === 'O') { stopAll(); runOpsec(); }
        else if (k === 'T') toggleTurbo();
        else if (k === 'S') togglePanel();
        else if (k === 'D') toggleDark();
        else if (k === 'G') toggleGhost();
        else if (k === 'L') cyclePosition();
        else if (k === 'K') testAPI();
        else if (k === 'P') {
            if (S.mode === 'jko') {
                S.isPaused = !S.isPaused;
                setStatus(S.isPaused ? 'PAUSED' : 'RUNNING', 50);
                if (!S.isPaused) cycleJKO();
            }
        }
        else if (k === 'H') {
            stopAll();
            S.cycle = 0;
            setStatus('HOME', 0);
            root.style.boxShadow = 'none';
            stopBlink();
        }
    });

    // ═══════════════════════════════════════════════════════════════
    // CONSOLE SUCCESS MESSAGE
    // ═══════════════════════════════════════════════════════════════
    console.log('%c✓ Clippy\'s Pilot loaded successfully!', 'color:#00d632;font-weight:bold;font-size:14px;');
    console.log('%cShortcuts: J=JKO | C=Cyber | O=OPSEC | T=Turbo | S=Panel | D=Dark | G=Ghost | L=Position', 'color:#1a3a5c;font-size:11px;');

})();
