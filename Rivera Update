    // --- LOAD SAVED SETTINGS ---
    if (state.config.saveEnabled && localStorage.getItem('clippy_win11_config')) {
        try {
            const saved = JSON.parse(localStorage.getItem('clippy_win11_config'));
            state.config = { ...DEFAULT_CONFIG, ...saved };
        } catch (e) {}
    }
    // Load saved cert dates
    if (localStorage.getItem('clippy_cert_dates')) {
        try {
            state.certDates = JSON.parse(localStorage.getItem('clippy_cert_dates'));
        } catch (e) {}
    }

    // --- AUDIO ENGINE ---
    const playSound = (type) => {
        if (state.config.muted) return;
        try {
            if (!state.audioCtx) state.audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = state.audioCtx.createOscillator();
            const gain = state.audioCtx.createGain();
            osc.connect(gain);
            gain.connect(state.audioCtx.destination);

            if (type === 'chime') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, state.audioCtx.currentTime); 
                osc.frequency.setValueAtTime(392.00, state.audioCtx.currentTime + 0.1); 
                gain.gain.setValueAtTime(0.5, state.audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, state.audioCtx.currentTime + 1.5);
                osc.start(); osc.stop(state.audioCtx.currentTime + 1.5);
            } else if (type === 'click') {
                osc.type = 'square';
                osc.frequency.value = 600;
                gain.gain.setValueAtTime(0.1, state.audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, state.audioCtx.currentTime + 0.1);
                osc.start(); osc.stop(state.audioCtx.currentTime + 0.1);
            }
        } catch(e) {}
    };

