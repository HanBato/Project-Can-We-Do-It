        darkModeBG: true,
        saveEnabled: true,
        muted: false,
        showLocation: false,
        showName: true,
        showTimer: true,
        showTemp: true,
        showDate: true,
        ghostModeOn: false
    };

    let state = {
        isRunning: false,
        isPaused: false,
        mode: 'home',
        cycle: 0,
        failCount: 0,
        uptimeStart: Date.now(),
        isGhost: false,
        isTurbo: false,
        timer: null,
        nextCycle: null,
        audioCtx: null,
        config: { ...DEFAULT_CONFIG },
        isMinimized: false,
        isHidden: false,
        lastSpacePress: 0,
        supportShown: false,
        certDates: {} // Stores saved due dates
